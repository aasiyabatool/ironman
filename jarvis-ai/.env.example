# Copy this file to ".env" and fill in your real values.
# Never commit your actual .env file to GitHub.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use
# Free-tier daily quotas are set PER MODEL and change often as Google
# ships new versions and retires old ones. If you get a 429 (quota) or
# 404 ("no longer available to new users") error, check your project's
# actual available models and live limits at:
#   https://aistudio.google.com/rate-limit
# Then set GEMINI_MODEL below to whatever is currently available, e.g.:
#   gemini-3.1-flash-lite   (current lightweight model, recommended default)
#   gemini-3.5-flash        (current flagship — smaller free daily quota)
# Avoid gemini-2.0-flash and gemini-2.5-flash-lite — retired / closed to new users.
GEMINI_MODEL=gemini-3.1-flash-lite

# Whisper model size: tiny | base | small | medium | large
# "tiny" is fastest, "base" is a good balance for laptops
WHISPER_MODEL_SIZE=base

# How many seconds to record per turn (fixed-duration mode)
RECORD_SECONDS=5

# TTS engine: gtts (online, natural) or pyttsx3 (offline, robotic)
TTS_ENGINE=gtts

# How JARVIS addresses you: Sir or Ma'am
ASSISTANT_TITLE=Sir

# Preferred voice gender when using pyttsx3 (no effect on gTTS, which
# only has one voice per language). "male" or "female".
TTS_VOICE_GENDER=male

# Applies a JARVIS-style pitch-shift + robotic warble to every reply,
# on top of either TTS engine. Requires ffmpeg (already installed for
# Whisper). Set to "false" to hear the raw, unprocessed voice.
ROBOT_VOICE_EFFECT=true

# ----------------------------
# Wake Word (openWakeWord — free, local, no account needed)
# ----------------------------
# Listens for "Hey Jarvis". Score threshold from 0-1: lower = more
# sensitive (may false-trigger more), higher = stricter (may miss
# you occasionally). 0.5 is the recommended default.
WAKE_WORD_THRESHOLD=0.5
